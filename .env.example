# JSON Server base URL — use http://localhost:8080 for the local db.json
# (run `pnpm db` first), or keep the hosted mock API.
NEXT_PUBLIC_API_URL=https://jsonmedium.vercel.app

# Cloudinary (unsigned upload preset) — used by the admin post form.
# Replace with your own cloud name + unsigned preset to avoid shared usage.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dywbf3czv
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=ruvcqm7j
